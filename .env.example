# Change this
DISCORD_TOKEN = "" # Discord bot token
GUILD_ID = "" # Discord server ID

# Config
DISCORD_PREFIX = "" # Prefix for message commands, defaults to &
GEMINI_KEY = "" # Gemini API key for AI features, if not set AI features are disabled

# Channel Ids
CHANNEL_DAILY = "" # Daily challenge channel, if not set daily challenges features are disabled
CHANNEL_SUGGEST = "" # Suggetions channel, if not set suggestion features are disabled
CHANNEL_SHOWCASE = "" # Showcase channel, if not set showcase features are disabled
SHOWCASE_CACHE_PATH = "" # Showcase cache, defaults to showcase_cache.json
TEMPORAL_WAIT = "" # Temporal channel wait lobby, if not set temporal channel features are disabled
TEMPORAL_CATEGORY = "" # Category where temporal channels are created, if not set temporal channel features are disabled
TEMPORAL_LOGS = "" # Channel for storing temporal channel logs (messages), if not set temporal channel features are disabled

# API Config
# Keep this for development
BOT_API_PORT = "" # API Port, defaults to 8080
BOT_API_ADDR = "" # API Host, defaults to 0.0.0.0
BOT_APIKEY = "" # API Secret, if not set API features are disabled
